--swiftversion 6.0

--indent 4
--maxwidth 120

--wraparguments before-first
--wrapcollections before-first
--wrapparameters before-first
--wrapreturntype if-multiline

--commas always
--header strip
--importgrouping testable-bottom
--self remove

--marktypes always
--markextensions always

--elseposition same-line
--guardelse same-line

--decimalgrouping 3
--hexgrouping 4

--funcattributes prev-line
--typeattributes prev-line
--varattributes same-line
--modifierorder nonisolated,override,public,internal,fileprivate,private,fileprivate(set),private(set),open,static,dynamic,optional,lazy,final,required,convenience,weak,unowned
--shortoptionals always
--redundanttype inferred
--patternlet hoist
--trimwhitespace always
--operatorfunc spaced
--ranges spaced

# redundantSendable (added as a default in swiftformat 0.61) strips explicit
# Sendable from non-public types. We keep those conformances explicit on purpose:
# under SWIFT_DEFAULT_ACTOR_ISOLATION = MainActor they document which value types
# are deliberately nonisolated/Sendable. Disabling also keeps CI (unpinned brew
# swiftformat) deterministic across version bumps.
--disable redundantSendable

--exclude build,DerivedData,.build,spec-docs,docs
