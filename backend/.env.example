# =====================================================================
# CareCircle backend — local development environment
# Copy to .env to use with docker compose.
#
# This file mirrors the Zod schemas in:
#   - apps/api/src/config.ts
#   - apps/worker/src/config.ts
# When you add a new env var to either schema, add it here too.
# =====================================================================

# ---------- Process ----------
NODE_ENV=development
LOG_LEVEL=info

# ---------- Postgres ----------
# Used by docker-compose for the postgres service:
POSTGRES_USER=carecircle
POSTGRES_PASSWORD=carecircle
POSTGRES_DB=carecircle
POSTGRES_HOST=localhost
POSTGRES_PORT=5433
# Consumed by the app:
DATABASE_URL=postgres://carecircle:carecircle@localhost:5433/carecircle
DIRECT_DATABASE_URL=postgres://carecircle:carecircle@localhost:5433/carecircle

# ---------- Redis ----------
REDIS_URL=redis://localhost:6390

# ---------- API server ----------
HOST=0.0.0.0
PORT=8080

# ---------- JWT ----------
# Min 32 chars. Rotate on incident.
JWT_SECRET=local-dev-jwt-secret-please-rotate-32-bytes-min
JWT_KID=local-v1
JWT_ISSUER=carecircle-local
JWT_AUDIENCE=carecircle.ios
ACCESS_TOKEN_TTL_SECONDS=900
REFRESH_TOKEN_TTL_SECONDS=2592000

# ---------- Sign in with Apple ----------
APPLE_CLIENT_ID=Res.CareCircle
APPLE_ISSUER=https://appleid.apple.com
APPLE_JWKS_URL=https://appleid.apple.com/auth/keys
# 'real' verifies tokens against Apple's JWKS (production).
# 'mock' verifies tokens signed with APPLE_MOCK_SECRET (tests / staging only).
APPLE_VERIFIER_MODE=real
APPLE_MOCK_SECRET=

# Optional — used only if you implement server-to-Apple flows (not v1):
APPLE_TEAM_ID=487LC4H9U4
APPLE_KEY_ID=
APPLE_PRIVATE_KEY=

# ---------- Master key (pgcrypto envelope encryption) ----------
# Min 32 chars. NEVER reuse across environments. Rotate quarterly.
APP_MASTER_KEY=local-dev-master-key-32-bytes-minimum-rotate-prod

# ---------- MinIO (S3-compatible object storage) ----------
# MINIO_ENDPOINT is the hostname only (no scheme, no port).
MINIO_ENDPOINT=localhost
MINIO_PORT=9100
MINIO_USE_SSL=false
MINIO_ACCESS_KEY=carecircle-minio
MINIO_SECRET_KEY=carecircle-minio-secret-please-rotate
MINIO_REGION=us-east-1
# Optional: if set, signed download URLs use this host instead of MINIO_ENDPOINT
# (useful when MinIO is behind a reverse proxy or CDN).
MINIO_PUBLIC_HOST=

# Bucket names (compose-up creates these). Code reads bucket names from the
# default constants in @carecircle/shared; overriding here is unusual.
MINIO_BUCKET_PHOTOS=cc-photos
MINIO_BUCKET_VOICE=cc-voice
MINIO_BUCKET_DOCUMENTS=cc-documents
MINIO_BUCKET_PDF=cc-pdf-exports
MINIO_BUCKET_BACKUPS=cc-backups

# ---------- Rate limits (requests / minute / IP) ----------
RATE_LIMIT_PER_MIN=100
AUTH_RATE_LIMIT_PER_MIN=10

# ---------- APNs (worker — push notifications) ----------
APNS_BUNDLE_ID=Res.CareCircle
APNS_TEAM_ID=487LC4H9U4
APNS_KEY_ID=
# Paste the .p8 contents (with -----BEGIN PRIVATE KEY----- headers) or base64 it.
APNS_PRIVATE_KEY=
APNS_ENVIRONMENT=development
# When true (default), worker logs push attempts but does not call APNs.
# Set to false in staging/prod once APNS_KEY_ID and APNS_PRIVATE_KEY are filled.
APNS_MOCK_MODE=true

# ---------- Optional external services ----------
OPENAI_API_KEY=
OPENFDA_API_KEY=

# ---------- Worker-only ----------
PDF_BUCKET=cc-pdf-exports
