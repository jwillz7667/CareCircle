{
  "$schema": "https://schema.railpack.com",
  "provider": "node",
  "packages": {
    "node": "22",
    "pnpm": "9.12.3"
  },
  "steps": {
    "install": {
      "commands": [
        "corepack enable",
        "corepack prepare pnpm@9.12.3 --activate",
        "pnpm install --frozen-lockfile"
      ]
    }
  },
  "deploy": {
    "startCommand": "pnpm --filter @carecircle/api start"
  }
}
